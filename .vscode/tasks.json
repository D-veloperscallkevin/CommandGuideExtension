// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
	"version": "2.0.0",
	"tasks": [
		{
            "label": "watch",
            "dependsOn": [
                "npm: watch:tsc",
                "npm: watch:esbuild",
                "npm: watch:webview"
            ],
            "presentation": {
                "reveal": "never"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "npm",
            "script": "watch:esbuild",
            "group": "build",
            // Formato que imprime el plugin de esbuild.js; sin depender de extensiones de terceros
            "problemMatcher": {
                "owner": "esbuild",
                "severity": "error",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "pattern": [
                    { "regexp": "^✘ \\[ERROR\\] (.*)$", "message": 1 },
                    { "regexp": "^\\s+(.*):(\\d+):(\\d+):$", "file": 1, "line": 2, "column": 3 }
                ],
                "background": {
                    "activeBegins": true,
                    "beginsPattern": "^\\[watch\\] build started",
                    "endsPattern": "^\\[watch\\] build finished"
                }
            },
            "isBackground": true,
            "label": "npm: watch:esbuild",
            "presentation": {
                "group": "watch",
                "reveal": "never"
            }
        },
		{
            "type": "npm",
            "script": "watch:webview",
            "group": "build",
            "isBackground": true,
            "label": "npm: watch:webview",
            // Errores de Vite: "[plugin] mensaje" y en la línea siguiente "╭─[ archivo:línea:col ]".
            // El build termina con "built in" si va bien o con "Build failed" si falla.
            "problemMatcher": {
                "owner": "vite",
                "severity": "error",
                "fileLocation": ["relative", "${workspaceFolder}/webview-ui"],
                "pattern": [
                    { "regexp": "^\\[([^\\]]+)\\] (.*)$", "code": 1, "message": 2 },
                    { "regexp": "^\\s*╭─\\[ (.+):(\\d+):(\\d+) \\]$", "file": 1, "line": 2, "column": 3 }
                ],
                "background": {
                    "activeBegins": true,
                    "beginsPattern": "build started",
                    "endsPattern": "built in|Build failed"
                }
            },
            "presentation": {
                "group": "watch",
                "reveal": "never"
            }
        },
		{
            "type": "npm",
            "script": "watch:tsc",
            "group": "build",
            "problemMatcher": "$tsc-watch",
            "isBackground": true,
            "label": "npm: watch:tsc",
            "presentation": {
                "group": "watch",
                "reveal": "never"
            }
        },
		{
			"type": "npm",
			"script": "watch-tests",
			"problemMatcher": "$tsc-watch",
			"isBackground": true,
			"presentation": {
				"reveal": "never",
				"group": "watchers"
			},
			"group": "build"
		},
		{
			"label": "tasks: watch-tests",
			"dependsOn": [
				"npm: watch",
				"npm: watch-tests"
			],
			"problemMatcher": []
		}
	]
}
