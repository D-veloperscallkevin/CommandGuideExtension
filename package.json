  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js && pnpm run build:webview",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "watch:webview": "pnpm --filter webview-ui exec vite build --watch",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production && pnpm run build:webview",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:unit": "vitest run",
    "build:webview": "pnpm --filter webview-ui run build",
    "lint:webview": "pnpm --filter webview-ui run lint",
    "verify": "node scripts/verify.mjs",
    "release:package": "node scripts/release-package.mjs",
    "prepare": "node scripts/install-hooks.mjs"
  },
